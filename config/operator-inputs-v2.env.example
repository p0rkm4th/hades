# Production v2 input template. Copy outside Git, replace every REQUIRED_ value,
# then protect the private copy with mode 0600. This file is shell-sourced by
# HADES scripts: use simple KEY=value lines and never put shell commands here.
# Do not use scripts/create-generated-private-inputs.sh for production; it is a
# synthetic fixture and its output is explicitly rejected outside test mode.
HADES_INPUTS_VERSION=2

# Persistent data, private configuration, and local backup roots.
HADES_STATE_ROOT=/var/lib/hades
HADES_CONFIG_ROOT=/etc/hades
HADES_BACKUP_ROOT=/var/backups/hades
HADES_IDENTITY_SECRETS_DIR=/etc/hades/secrets/identity
HADES_DEPLOYMENT_DIR=/etc/hades/private-deployment
HADES_HERMES_PROFILE=/etc/hades/hermes
HADES_HERMES_WORKING_DIRECTORY=/opt/hades
HADES_HERMES_EXECUTABLE=/opt/hades-hermes/bin/hermes
HADES_HERMES_RUNTIME_USER=hades-runtime
HADES_HERMES_RUNTIME_GROUP=hades-runtime
HADES_GROCY_URL=http://127.0.0.1:7003

# Explicit comma-separated stable Open WebUI subjects with owner-equivalent
# HADES policy (no spaces). Leave empty until the owner has authenticated and
# the subject has been verified against the intended LLDAP owner account.
HADES_OWNER_SUBJECT_IDS=

# Bind Hermes to the host's Docker bridge address, not 0.0.0.0. Verify the
# bridge gateway on this host. Containers reach host services through
# host.docker.internal; host preflight uses the host-reachable model URL.
HADES_HERMES_API_BIND_HOST=REQUIRED_DOCKER_BRIDGE_GATEWAY
HADES_HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HADES_HERMES_CONTAINER_API_BASE_URL=http://host.docker.internal:8642/v1
HADES_HERMES_API_KEY=REQUIRED_RANDOM_PRIVATE_KEY
HADES_HERMES_MODEL_ENDPOINT=http://REQUIRED_HOST_REACHABLE_MODEL_ENDPOINT
HADES_HERMES_CONTAINER_MODEL_ENDPOINT=http://REQUIRED_CONTAINER_REACHABLE_MODEL_ENDPOINT

# Optional native Open WebUI Ollama providers. Leave empty until explicitly
# configured to local/private model services.
HADES_OLLAMA_BASE_URLS=
HADES_FAST_OLLAMA_API_BASE_URL=

# Keep the WebUI bound to loopback unless a separately reviewed private access
# proxy is configured. The LDAP bind password must match the LLDAP account
# represented by HADES_IDENTITY_SECRETS_DIR/admin_password.
HADES_OPEN_WEBUI_BIND=127.0.0.1:3000
HADES_OPEN_WEBUI_LDAP_APP_PASSWORD=REQUIRED_MATCHING_LLDAP_BIND_PASSWORD
HADES_OPEN_WEBUI_IMAGE=REQUIRED_IMMUTABLE_BUILD_OUTPUT
HADES_OPEN_WEBUI_DATA=/var/lib/hades/open-webui
HADES_OPEN_WEBUI_SECRET_SOURCE=/var/lib/hades/secrets/open-webui-secret

# Component state and secrets. Create the identity files jwt_secret,
# key_seed, and admin_password with mode 0600 and owner UID 1000. The installer
# generates the Open WebUI signing key once if it is absent.
HADES_HINDSIGHT_DATA=/var/lib/hades/hindsight
HADES_SEARXNG_DATA=/var/lib/hades/searxng
HADES_HINDSIGHT_LLM_API_KEY=REQUIRED_RANDOM_PRIVATE_KEY
HADES_SEARXNG_SECRET_FILE=/etc/hades/secrets/searxng/secret_key
# This file must contain a key issued by the running Grocy instance through
# its Manage API keys page. Arbitrary random values do not authenticate.
HADES_GROCY_API_KEY_FILE=/etc/hades/secrets/grocy/api_key

# Optional Agent Zero credentials remain disabled when these are empty.
HADES_AGENT_ZERO_CREDENTIAL_FILE=
HADES_AGENT_ZERO_OPERATOR_PASSWORD_FILE=
HADES_AGENT_ZERO_OPERATOR_PROXY_ENABLED=false
