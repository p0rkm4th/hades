# Copy outside the repository (recommended: /etc/hades/operator-inputs.env),
# chmod 0600, and replace required values. Never commit the copy.
# Provenance: every value here is EXPLICIT OPERATOR INPUT.
HADES_INPUTS_VERSION=1
HADES_STATE_ROOT=/var/lib/hades
HADES_CONFIG_ROOT=/etc/hades
HADES_BACKUP_ROOT=/var/backups/hades
HADES_IDENTITY_SECRETS_DIR=/etc/hades/secrets/identity
# V2 generated-record inputs. Build the tracked Open WebUI artifact with
# scripts/build-open-webui-artifact.sh, then put its immutable local image
# reference here. The image contains no state or secret.
HADES_OPEN_WEBUI_IMAGE=REQUIRED_ARTIFACT_INPUT
HADES_OPEN_WEBUI_DATA=/var/lib/hades/open-webui
HADES_HINDSIGHT_DATA=/var/lib/hades/hindsight
HADES_SEARXNG_DATA=/var/lib/hades/searxng
HADES_SEARXNG_SECRET_FILE=/etc/hades/secrets/searxng/secret_key
HADES_HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
HADES_HINDSIGHT_LLM_API_KEY=REQUIRED_SECRET_INPUT
HADES_HERMES_WORKING_DIRECTORY=/opt/hades
HADES_HERMES_EXECUTABLE=/usr/bin/hermes
# Install with scripts/install-hermes-artifact.sh into a fresh prefix, or
# provide an operator-held archive matching HADES_HERMES_SOURCE_SHA256.
HADES_HERMES_ARTIFACT_ARCHIVE=
# LLDAP consumes files in this directory as its unprivileged UID 1000;
# generated/supplied files are mode 0600 and owned by UID 1000.
HADES_DEPLOYMENT_DIR=/etc/hades/private-deployment
HADES_OPEN_WEBUI_COMPOSE_FILE=/etc/hades/private-deployment/open-webui.compose.yaml
HADES_HINDSIGHT_COMPOSE_FILE=/etc/hades/private-deployment/hindsight.compose.yaml
HADES_SEARXNG_COMPOSE_FILE=/etc/hades/private-deployment/searxng.compose.yaml
HADES_HERMES_SERVICE_FILE=/etc/hades/private-deployment/hermes.service
HADES_HERMES_PROFILE=/etc/hades/hermes
HADES_OWNER_BOOTSTRAP_ID=REQUIRED_OPERATOR_INPUT
HADES_HERMES_API_KEY=REQUIRED_OPERATOR_INPUT
HADES_HERMES_MODEL_ENDPOINT=https://REQUIRED_OPERATOR_INPUT
HADES_HINDSIGHT_DATABASE_SECRET_FILE=/etc/hades/secrets/hindsight/database
HADES_GROCY_API_KEY_FILE=/etc/hades/secrets/grocy/api_key
HADES_AGENT_ZERO_CREDENTIAL_FILE=/etc/hades/secrets/agent-zero/credential
# Optional, only when the corresponding future capability is authorized.
HADES_SEARXNG_PRIVATE_SETTINGS_FILE=/etc/hades/secrets/searxng/settings.yml
HADES_ACTUAL_ENDPOINT=OPTIONAL_OWNER_AUTHORIZATION_REQUIRED
HADES_HOMELAB_ENDPOINT=OPTIONAL_OWNER_AUTHORIZATION_REQUIRED
HADES_HOME_ASSISTANT_ENDPOINT=OPTIONAL_OWNER_AUTHORIZATION_REQUIRED
