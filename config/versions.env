# Authoritative public version contract. Keep values pinned; never use latest.
# Sources and private image records are documented in docs/component-manifest.md.
HADES_MANIFEST_VERSION=1
HADES_HERMES_VERSION=0.14.0
# Open WebUI 0.11.5 is the compatibility baseline; its deployment image/build
# reference remains an explicit private record because no public v0.11.5 tag
# is currently available.
HADES_OPEN_WEBUI_VERSION=0.11.5
# The accepted HADES image is built from this immutable upstream base plus the
# tracked webui/ assets. The build output is local software custody, not state.
HADES_OPEN_WEBUI_BASE_IMAGE=ghcr.io/open-webui/open-webui@sha256:6bb1fbe8ab0a3e0456067f493044ffb66a30a65a34be47f6a5862176a370dd16
HADES_OPEN_WEBUI_BUILD_SOURCE=webui/Dockerfile
