    {"parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 1440}]}}, "id": "backup-schedule", "name": "Bounded backup schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [240, 300]},
