# Copy to /etc/hades/homelab-telemetry.env and set mode 0600.
# Supply only owner-approved read-only endpoints and credential file paths.
HADES_PROXMOX_RESOURCES_URLS=
HADES_PROXMOX_TOKEN_FILES=
HADES_PROXMOX_TOKEN_IDS=
HADES_PROXMOX_CA_FILE=
HADES_NETBOX_URL=
HADES_NETBOX_TOKEN_FILE=
HADES_UPTIME_KUMA_URL=
HADES_UPTIME_KUMA_STATUS_SLUG=
HADES_CAPABILITY_MATRIX_FILE=
HADES_GPU_TELEMETRY_CONFIG_FILE=
# Optional JSON array of provider IDs/URLs and protected token/CA file paths.
# Credentials require HTTPS. Keep host-specific values in the private env file.
HADES_INFERENCE_ENDPOINTS_JSON=
HADES_DISCOVERY_ALLOWED_NETWORKS=
