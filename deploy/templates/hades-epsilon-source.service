[Unit]
Description=HADES bounded Epsilon read-only source endpoint
After=network-online.target

[Service]
Type=simple
User=scotty
ExecStart=/usr/bin/python3 /var/lib/hades/config/epsilon-source/server.py
Environment=HADES_EPSILON_BACKUP_ROOT=/var/lib/hades/backups/epsilon-phase2-custody
Environment=HADES_EPSILON_BACKUP_MAX_AGE=604800
Environment=HADES_EPSILON_VERIFY_REPO=/var/lib/hades/backups/epsilon-phase2-custody/verification.git
Environment=HADES_DEPLOYED_PROVENANCE_FILE=/var/lib/hades/config/epsilon-source/hades-live-provenance.json
Environment=HADES_EPSILON_SOURCE_BIND=172.17.0.1
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/hades/backups/epsilon-phase2-custody
ReadOnlyPaths=/var/lib/hades/config/epsilon-source/hades-live-provenance.json
MemoryMax=128M

[Install]
WantedBy=multi-user.target
