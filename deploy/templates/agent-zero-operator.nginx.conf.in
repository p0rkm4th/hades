# Generated from the HADES template. Both listeners stay loopback-only.
# Browser cookies are shared between ports, so the gateway filters them before
# either application receives a request.
worker_processes 1;
pid /tmp/hades-operator-nginx.pid;
error_log stderr warn;
daemon off;

events { worker_connections 256; }

http {
  access_log off;
  server_tokens off;
  client_max_body_size 1g;
  client_body_timeout 300s;
  send_timeout 3600s;
  client_body_temp_path /tmp/client_body_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;
  proxy_connect_timeout 5s;
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;
  proxy_buffering off;
  proxy_request_buffering off;

  map $http_upgrade $hades_connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen 127.0.0.1:@WEBUI_FRONT_PORT@ default_server;
    server_name _;

    location = /__hades_cookie_filter {
      internal;
      proxy_pass http://127.0.0.1:@AUTH_PORT@/webui-cookie;
      proxy_pass_request_body off;
      proxy_set_header Content-Length '';
      proxy_set_header Cookie $http_cookie;
      proxy_set_header Authorization '';
    }

    location / {
      auth_request /__hades_cookie_filter;
      auth_request_set $hades_webui_cookie $upstream_http_x_hades_webui_cookie;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $hades_connection_upgrade;
      proxy_set_header Cookie $hades_webui_cookie;
      proxy_pass http://127.0.0.1:@WEBUI_UPSTREAM_PORT@;
    }
  }

  server {
    listen 127.0.0.1:@OPERATOR_FRONT_PORT@ default_server;
    server_name _;

    location = /__hades_operator_auth {
      internal;
      proxy_pass http://127.0.0.1:@AUTH_PORT@/authorize;
      proxy_pass_request_body off;
      proxy_set_header Content-Length '';
      proxy_set_header Cookie $http_cookie;
      proxy_set_header Authorization $http_authorization;
    }

    location / {
      auth_request /__hades_operator_auth;
      auth_request_set $hades_agent_zero_cookie $upstream_http_x_hades_agent_zero_cookie;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $hades_connection_upgrade;
      proxy_set_header Cookie $hades_agent_zero_cookie;
      proxy_set_header Authorization '';
      proxy_set_header X-Hades-Authenticated-User '';
      proxy_set_header X-Hades-Authenticated-Groups '';
      proxy_set_header X-Hades-Proxy-Secret '';
      proxy_pass http://127.0.0.1:@AGENT_ZERO_UPSTREAM_PORT@;
    }
  }
}
