#!/usr/bin/env bash
set -Eeuo pipefail
repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
command=${1:-help}
if [[ "$command" == "-h" || "$command" == "--help" ]]; then command=help; fi
[[ $# -gt 0 ]] && shift || true
if [[ "$command" == setup ]]; then
  exec python3 "$repo_dir/scripts/setup-hades.py" "$@"
fi
inputs=''; root=/; test_mode=0; confirm=0; path=''; target=''; component=''; backup_dir=''; apply=0; json_mode=0
usage() {
  echo 'Usage: scripts/hades COMMAND [--inputs FILE] [--root DIR] [--test-mode]'
  echo 'Commands: setup install preflight doctor status version validate repair reconfigure backup restore upgrade uninstall'
  echo 'Extra: --path DIR --target DIR --component NAME --backup-dir DIR --apply --confirm'
  echo 'restore verifies by default; --apply --confirm restores supported SQLite state to a prepared target.'
}
while (($#)); do
  case "$1" in
    --inputs) inputs=${2:?--inputs needs FILE}; shift 2 ;;
    --root) root=${2:?--root needs DIR}; shift 2 ;;
    --test-mode) test_mode=1; shift ;;
    --confirm) confirm=1; shift ;;
    --path|--checkpoint) path=${2:?--path needs DIR}; shift 2 ;;
    --target) target=${2:?--target needs DIR}; shift 2 ;;
    --component) component=${2:?--component needs NAME}; shift 2 ;;
    --backup-dir) backup_dir=${2:?--backup-dir needs DIR}; shift 2 ;;
    --apply) apply=1; shift ;;
    --json) json_mode=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "FAIL unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done
run_check() {
  local script=$1; local mode=()
  (( test_mode )) && mode+=(--test-mode)
  [[ -n "$inputs" ]] && mode+=(--inputs "$inputs")
  [[ "$root" != / ]] && mode+=(--root "$root")
  bash "$repo_dir/scripts/$script" "${mode[@]}"
}
run_install() {
  local mode=()
  (( test_mode )) && mode+=(--test-mode)
  [[ -n "$inputs" ]] && mode+=(--inputs "$inputs")
  [[ "$root" != / ]] && mode+=(--root "$root")
  bash "$repo_dir/scripts/install-hades.sh" "${mode[@]}"
}
json_status() {
  python3 - "$repo_dir" "$root" "$inputs" "$json_mode" <<'PY'
import hashlib, json, os, subprocess, sys
from pathlib import Path
repo, root, inputs, _ = sys.argv[1:]
def sha(path):
    try: return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    except OSError: return None
def git_head():
    try: return subprocess.check_output(['git','-C',repo,'rev-parse','HEAD'], text=True).strip()
    except Exception: return 'unknown'
manifest = Path(repo) / 'config/versions.env'
release = 'unknown'
try:
    release = next(line.split('=',1)[1] for line in manifest.read_text().splitlines() if line.startswith('HADES_RELEASE_VERSION='))
except (OSError, StopIteration):
    pass
state_root = os.path.join(root.rstrip('/'), 'var/lib/hades')
provenance = os.path.join(state_root, 'provenance.json')
value = {
  'status': 'ok',
  'hades_commit': git_head(),
  'release_version': release,
  'manifest_sha256': sha(manifest),
  'provenance': None,
  'checks': {'source_manifest': manifest.is_file(), 'provenance': os.path.isfile(provenance)},
}
if os.path.isfile(provenance):
    try: value['provenance'] = json.loads(Path(provenance).read_text())
    except Exception: value['status'] = 'degraded'
else:
    value['status'] = 'not-installed'
if inputs and not os.path.isfile(inputs):
    value['status'] = 'degraded'; value['checks']['operator_inputs'] = False
elif inputs:
    value['checks']['operator_inputs'] = True
print(json.dumps(value, sort_keys=True, indent=2))
sys.exit(0 if value['status'] == 'ok' else 1)
PY
}
case "$command" in
  help) usage ;;
  version)
    if (( json_mode )); then json_status; else
      echo "release_version=$(awk -F= '$1 == "HADES_RELEASE_VERSION" {print $2}' "$repo_dir/config/versions.env")"
      echo "hades_commit=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || echo unknown)"
      echo "manifest_sha256=$(sha256sum "$repo_dir/config/versions.env" | awk '{print $1}')"
      echo "source=$repo_dir"
    fi
    ;;
  install|repair|reconfigure) run_install ;;
  preflight)
    args=(--preflight); (( test_mode )) && args+=(--test-mode)
    [[ -n "$inputs" ]] && args+=(--inputs "$inputs")
    [[ "$root" != / ]] && args+=(--root "$root")
    bash "$repo_dir/scripts/install-hades.sh" "${args[@]}" ;;
  doctor|status) if (( json_mode )); then json_status; else run_check hades-doctor.sh; fi ;;
  validate) run_check validate-install.sh ;;
  backup)
    [[ -n "$path" ]] || { echo 'FAIL backup requires --path EXISTING_PRIVATE_DIRECTORY' >&2; exit 2; }
    bash "$repo_dir/scripts/backup-sqlite-state.sh" "$path" ;;
  restore)
    [[ -n "$path" ]] || { echo 'FAIL restore requires --path CHECKPOINT_DIRECTORY' >&2; exit 2; }
    bash "$repo_dir/scripts/check-recovery-artifacts.sh" "$path"
    if (( apply )); then
      (( confirm )) || { echo 'FAIL applied restore requires --confirm' >&2; exit 2; }
      [[ -n "$target" ]] || { echo 'FAIL applied restore requires --target PREPARED_TARGET' >&2; exit 2; }
      python3 "$repo_dir/scripts/restore-sqlite-state.py" "$path" "$target" --confirm
      echo 'REVIEW restart the prepared stack, then run doctor, validate, authentication, canonical-state, and owner acceptance checks.'
    else
      echo 'PASS checkpoint verified; no application state was changed.'
      echo 'REVIEW use --apply --confirm --target PREPARED_TARGET for supported SQLite state; other components require native restore procedures.'
    fi
    ;;
  upgrade)
    [[ -n "$component" && -n "$inputs" && -n "$backup_dir" ]] || { echo 'FAIL upgrade requires --component, --inputs, and --backup-dir' >&2; exit 2; }
    args=(--component "$component" --inputs "$inputs" --backup-dir "$backup_dir")
    (( apply )) && args+=(--apply)
    bash "$repo_dir/scripts/upgrade-hades.sh" "${args[@]}" ;;
  uninstall)
    (( confirm )) || { echo 'FAIL uninstall requires --confirm' >&2; exit 2; }
    [[ -n "$inputs" ]] || { echo 'FAIL uninstall requires --inputs' >&2; exit 2; }
    source "$inputs"
    for compose_file in "${HADES_OPEN_WEBUI_COMPOSE_FILE:-}" "${HADES_HINDSIGHT_COMPOSE_FILE:-}" "${HADES_SEARXNG_COMPOSE_FILE:-}" "$repo_dir/deploy/lldap.compose.yaml" "$repo_dir/deploy/grocy.compose.yaml" "$repo_dir/deploy/agent-zero.compose.yaml"; do
      [[ -f "$compose_file" ]] || continue
      docker compose --env-file "$inputs" -f "$compose_file" down --remove-orphans
    done
    systemctl disable --now hades-hermes.service 2>/dev/null || true
    echo 'PASS runtime stopped; persistent state, secrets, backups, and source were preserved'
    ;;
  *) echo "FAIL unsupported lifecycle command: $command" >&2; usage >&2; exit 2 ;;
esac
