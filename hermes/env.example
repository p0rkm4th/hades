# Copy to the Hermes profile .env outside this repository and replace the
# placeholder. Never commit the real key.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=REPLACE_WITH_A_RANDOM_PRIVATE_KEY
API_SERVER_MODEL_NAME=hermes-agent
HADES_HERMES_WORKING_DIRECTORY=/opt/hades
HADES_GROCY_URL=http://127.0.0.1:7003
HADES_GROCY_API_KEY_FILE=/etc/hades/secrets/grocy-api-key

# The Hermes API must also accept connections from the Docker host-gateway
# address so Open WebUI can reach it. Set API_SERVER_HOST to that verified
# bridge address when using the generated Compose records; never use 0.0.0.0.

# Optional deployment compatibility overlay. Keep the checked-in source at
# hermes/sitecustomize.py and point PYTHONPATH at the deployment copy, or use
# the repository file directly from a controlled checkout.
# PYTHONPATH=/path/to/hades/hermes

# Bound owner-facing API agent loops so abandoned clients cannot consume the
# local model indefinitely.
HERMES_MAX_ITERATIONS=12

# Keep browser-facing CORS disabled for the server-to-server Open WebUI path.
# Add an explicit private origin only if a browser must call Hermes directly.
# Comma-separated public hostnames permitted to the anonymous browser-research
# adapter. Leave empty to keep that MCP unavailable; no credentials or cookies.
HADES_BROWSER_ALLOWED_HOSTS=
# Public research may use that same anonymous browser for one failed/empty
# static page per question. Keep disabled unless the host allowlist above is
# explicitly reviewed for the target workload.
HADES_PUBLIC_RESEARCH_DYNAMIC_ENABLED=false

# Homelab read-only MCP. Base URLs and protected token-file paths are private
# operator inputs; the adapter derives only bounded GET endpoints and exposes
# no lifecycle, network, credential, or inventory-write operation.
HADES_PROXMOX_URL=
HADES_PROXMOX_TOKEN_FILE=
# For standalone nodes, use comma-separated matching URL/token-file lists;
# one token file may be repeated only when the same secret is valid everywhere.
HADES_PROXMOX_RESOURCES_URLS=
HADES_PROXMOX_TOKEN_FILES=
HADES_PROXMOX_TOKEN_IDS=
HADES_PROXMOX_CA_FILE=
HADES_NETBOX_URL=
HADES_NETBOX_TOKEN_FILE=
HADES_UPTIME_KUMA_URL=
HADES_UPTIME_KUMA_STATUS_SLUG=
HADES_KUMA_TOKEN_FILE=
HADES_DISCOVERY_ALLOWED_NETWORKS=
# Optional owner-only live GPU telemetry profile. Keep this JSON profile,
# identity key, and pinned known_hosts file outside the repository.
HADES_GPU_TELEMETRY_CONFIG_FILE=
# Optional owner-only provider catalog endpoints. Use JSON; token-bearing URLs
# require HTTPS. Keep endpoint details in the private environment file.
HADES_INFERENCE_ENDPOINTS_JSON=
